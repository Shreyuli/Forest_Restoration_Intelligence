# Copy to .env and fill in to enable Claude-polished recommendation prose.
# The system runs fully without this (deterministic template text) — useful
# for CI and for judges running the demo without a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
USE_LLM=1

# Usually fine to leave at their defaults (relative to backend/store/):
SQLITE_PATH=
CHROMA_PERSIST_DIR=
RETRIEVAL_TOP_K=3
